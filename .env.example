# Add the final public domain before deployment. No trailing slash.
NEXT_PUBLIC_SITE_URL=

# Match the exact browser origin, no trailing slash. HTTPS is required except loopback.
PANO_APP_ORIGIN=http://127.0.0.1:4174
PANO_PRIVATE_DIR=.private
# Keep false until the worker, security scanner and provider are configured.
PANO_UPLOADS_ENABLED=false
PANO_TRUST_PROXY=false
MODERATION_PROVIDER=disabled
MODERATION_API_KEY=
MODERATION_VISION_MODEL=gpt-4.1-mini
MODERATION_SAFETY_MODEL=omni-moderation-latest
MODERATION_TRANSCRIPTION_MODEL=gpt-4o-mini-transcribe
MODERATION_TIMEOUT_MS=30000
PANO_MODERATION_POLICY_VERSION=PANO_POLICY_2026_01
MAX_IMAGE_SIZE_MB=10
MAX_VIDEO_SIZE_MB=50
VIDEO_DURATION_SECONDS=8
VIDEO_DURATION_TOLERANCE_SECONDS=0.25
VIDEO_MODERATION_SAMPLE_INTERVAL_MS=500
VIDEO_MODERATION_MAX_FRAMES=64
# Use absolute paths to trusted, current system binaries in production.
FFMPEG_PATH=ffmpeg
FFPROBE_PATH=ffprobe
CLAMSCAN_PATH=
REJECTED_MEDIA_RETENTION_DAYS=2
REVIEW_MEDIA_RETENTION_DAYS=7
APPROVED_MEDIA_RETENTION_DAYS=90
UPLOADS_PER_SESSION_HOUR=10
UPLOADS_GLOBAL_HOUR=100
UPLOADS_GLOBAL_PENDING=20
MAX_PRIVATE_STORAGE_MB=5120
# Set PANO_ADMIN_PASSWORD temporarily in the terminal for admin:create, not here.

# Optional verified-mailbox email changes. Requires both old/new inbox codes.
# No email is delivered and the account address is unchanged when unconfigured.
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
